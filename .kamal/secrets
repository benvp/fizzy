GITHUB_SECRETS=$(kamal secrets fetch --adapter 1password --account vpsolutions --from Private/GitHub token)
APP_SECRETS=$(kamal secrets fetch --adapter 1password --account vpsolutions --from vp.solutions/fizzy secret_key_base smtp_username smtp_password vapid_private_key vapid_public_key allowed_signup_domains)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract token $GITHUB_SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract secret_key_base $APP_SECRETS)
SMTP_USERNAME=$(kamal secrets extract smtp_username $APP_SECRETS)
SMTP_PASSWORD=$(kamal secrets extract smtp_password $APP_SECRETS)
VAPID_PRIVATE_KEY=$(kamal secrets extract vapid_private_key $APP_SECRETS)
VAPID_PUBLIC_KEY=$(kamal secrets extract vapid_public_key $APP_SECRETS)

ALLOWED_SIGNUP_DOMAINS=$(kamal secrets extract allowed_signup_domains $APP_SECRETS)
